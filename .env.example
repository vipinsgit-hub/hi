# Supabase Configuration for HI Chat Application
# Project: HiChat (Region: Seoul)
# Supabase URL: https://qstlprcewjnmqexiqgjj.supabase.co
#
# IMPORTANT SECURITY NOTES:
# 1. ONLY use the public publishable (anon) key here.
# 2. NEVER put the 'service_role' key, database password, or secret keys here.
# 3. If credentials are left blank, the app will run in Development Preview mode.

VITE_SUPABASE_URL=https://qstlprcewjnmqexiqgjj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Optional: Backward-compatible alias for publishable key
VITE_SUPABASE_ANON_KEY=

# Optional: Default Chat Room ID (if pre-configured)
VITE_DEFAULT_ROOM_ID=
